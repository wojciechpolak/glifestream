{
  "name": "glifestream-frontend",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node frontend/build.ts",
    "watch": "node frontend/build.ts --watch",
    "typecheck": "tsc -p frontend/src && tsc -p frontend",
    "lint": "oxlint --type-aware --deny-warnings frontend",
    "format": "oxfmt frontend .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check frontend .oxlintrc.json .oxfmtrc.json",
    "test": "vitest run --config frontend/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "photoswipe": "5.4.4"
  }
}
