{
    "compilerOptions": {
        "target": "es2024",
        "lib": ["es2024"],
        "module": "nodenext",
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        // Vitest's and happy-dom's declarations expect newer Node and DOM
        // types than a Node-only project has; only our own files are checked.
        "skipLibCheck": true
    },
    "include": ["build.ts", "vitest.config.ts"]
}
