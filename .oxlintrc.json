{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "env": {
        "browser": true,
        "es2024": true
    },
    "globals": {
        "gettext_msg": "readonly",
        "settings": "readonly",
        "stream_data": "readonly"
    },
    "rules": {
        "eslint/no-underscore-dangle": ["warn", { "allow": ["__glsReloadHandler"] }],
        // Elements the templates render are asserted to their type where the
        // modules look them up, not checked, as are indexes into arrays
        // noUncheckedIndexedAccess types as possibly missing.
        "typescript/no-unsafe-type-assertion": "off"
    },
    "overrides": [
        {
            "files": ["frontend/*.ts"],
            "env": {
                "browser": false,
                "node": true
            }
        }
    ]
}
