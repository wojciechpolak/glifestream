log_format custom '$remote_addr - $remote_user [$time_local] '
                  '"$request" $status $body_bytes_sent '
                  '"$http_referer" "$http_user_agent" "$http_x_forwarded_for"';

upstream backend {
    server app:80;
}

# Media types a browser may show inline. Anything else, SVG and HTML
# included, is sent as a download so an uploaded file cannot run as the site.
# The first matching regex wins, and an empty value sends no header.
map $sent_http_content_type $media_disposition {
    default                   attachment;
    ~*^image/svg\+xml         attachment;
    ~*^(image|audio|video)/   "";
    ~*^application/pdf        "";
}

# Password guessing: each client may POST 6 logins a minute, after a burst
# of 5. GET requests have an empty key, which nginx does not count.
map $request_method $login_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $login_limit_key zone=login:1m rate=6r/m;

# Behind another reverse proxy, every client arrives from the proxy's
# address and shares one limit. Trust the proxy's header to tell them apart:
# set_real_ip_from 172.16.0.0/12;
# real_ip_header X-Forwarded-For;

server {
    listen 80;
    server_name ${VIRTUAL_HOST};
    root /app;
    index index.html;

    access_log /proc/1/fd/1 custom;
    error_log /proc/1/fd/2;

    gzip_static on;
    client_max_body_size 10M;

    location ^~ ${VIRTUAL_PATH}media/ {
        alias /app/media/;
        access_log off;
        add_header Cache-Control public;
        add_header X-Content-Type-Options nosniff;
        add_header Content-Disposition $media_disposition;
        expires 365d;
    }

    location ^~ ${VIRTUAL_PATH}static/ {
        alias /app/static/;
        access_log off;
        add_header Cache-Control public;
        expires 365d;
    }

    location = /favicon.ico {
        root /app/run/static;
        access_log off;
    }
    location = /robots.txt {
        root /app/run/static;
        access_log off;
    }

    location ^~ ${VIRTUAL_PATH}login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://backend/login;
        proxy_set_header Host $http_host;
    }

    location ^~ ${VIRTUAL_PATH}admin/login/ {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://backend/admin/login/;
        proxy_set_header Host $http_host;
    }

    location ${VIRTUAL_PATH} {
        proxy_pass http://backend/; # keep the trailing slash
        proxy_set_header Host $http_host;
    }
}
