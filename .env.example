APP_DEBUG=1
APP_SECRET_KEY=change-me-to-a-long-random-secret
# Password of the first administrator; left unset, one is generated and printed.
# INITIAL_ADMIN_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000

RUN_DIR=./run
RUN_DIR_MEDIA=./media

DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=./run/db/dev.sqlite3

STREAM_TITLE=Stream
STREAM_TITLE_SUFFIX=" | Stream"
STREAM_DESCRIPTION="A short description"
# Lines of an entry the timeline shows before "Show more" (0: never fold).
FOLD_LINES=20
# The themes a visitor can switch between (default: all bundled ones:
# default,broadsheet,phosphor,riso,dotfiles), and the one a visitor starts with
# (default: the first of THEMES).
# THEMES=default,riso
# DEFAULT_THEME=riso

FEED_AUTHOR_NAME="YOUR NAME"
FEED_AUTHOR_URI=http://localhost:8000/
FEED_TAGURI=tag:SITE-ID,YEAR:ID
FEED_ICON=http://URL-TO-ICON

# Posting by e-mail (worker.py --email2post) stays off until this is set.
# EMAIL2POST_SECRET=generate-with-python-secrets-token-hex

MAGICSSO_ENABLED=0
MAGICSSO_SERVER_URL=http://localhost:3000
MAGICSSO_JWT_SECRET=change-me-to-a-long-random-jwt-secret
MAGICSSO_PREVIEW_SECRET=change-me-to-a-long-random-preview-secret
