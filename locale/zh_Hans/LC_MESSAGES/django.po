msgid "Full release notes"
msgstr "完整发布说明"

msgid "Show more"
msgstr "显示更多"

msgid "Show less"
msgstr "收起"

msgid "Fold long entries"
msgstr "折叠长条目"

msgid "Lines of an entry the timeline shows before \"Show more\". 0 never folds. Empty uses the site default."
msgstr "时间线在“显示更多”之前显示的条目行数。0 表示从不折叠。留空则使用站点默认值。"

#, python-format
msgid "Merged pull request #%(number)s in %(repo)s: %(title)s"
msgstr "在 %(repo)s 中合并了拉取请求 #%(number)s：%(title)s"

#, python-format
msgid "Opened pull request #%(number)s in %(repo)s: %(title)s"
msgstr "在 %(repo)s 中创建了拉取请求 #%(number)s：%(title)s"

#, python-format
msgid "Opened issue #%(number)s in %(repo)s: %(title)s"
msgstr "在 %(repo)s 中创建了议题 #%(number)s：%(title)s"

#, python-format
msgid "Pushed %(count)d commit to %(branch)s in %(repo)s"
msgid_plural "Pushed %(count)d commits to %(branch)s in %(repo)s"
msgstr[0] "向 %(repo)s 的 %(branch)s 推送了 %(count)d 个提交"

msgid "See all changes"
msgstr "查看所有更改"

#, python-format
msgid "%(count)d entry of the unchecked kinds is now hidden."
msgid_plural "%(count)d entries of the unchecked kinds are now hidden."
msgstr[0] "已隐藏未勾选类型的 %(count)d 条内容。"

#, python-format
msgid "%(count)d entry of the checked kinds is shown again."
msgid_plural "%(count)d entries of the checked kinds are shown again."
msgstr[0] "已重新显示勾选类型的 %(count)d 条内容。"
