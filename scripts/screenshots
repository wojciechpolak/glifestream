#  under the terms of the GNU General Public License as published by the
#  Free Software Foundation; either version 3 of the License, or (at your
#  option) any later version.
#
#  This program is distributed in the hope that it will be useful,
#  but WITHOUT ANY WARRANTY; without even the implied warranty of
#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#  GNU General Public License for more details.
#
#  You should have received a copy of the GNU General Public License along
#  with this program.  If not, see <https://www.gnu.org/licenses/>.

Take the README screenshots of the stream, in a light and a dark version.

It builds the page script, sets up a throwaway instance the way a fresh
installation starts -- the starting services and the welcome entry, in a
database in a temporary directory -- serves it with `runserver`, and has
Chromium photograph the home page once per colour scheme. The results are
written as WebP to docs/screenshots/. Neither `.env` nor `settings_local.py`
is read, so your own instance and its data never show up in them.

The welcome entry's video thumbnail comes from YouTube, so this needs the
network. It needs the `dev` dependency group and Playwright's Chromium
(`uv run playwright install chromium`), as the browser tests do.
"""

from __future__ import annotations

import argparse
import os
import secrets
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from io import BytesIO
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VENV = ROOT / '.venv'
VENV_PYTHON = VENV / 'bin' / 'python'
OUTPUT_DIR = ROOT / 'docs' / 'screenshots'

VIEWPORT = {'width': 1200, 'height': 800}
# Photographed at twice the CSS size, so the images stay sharp on HiDPI
# screens when the README shows them at the width of its column.
SCALE = 2
WEBP_QUALITY = 80
SCHEMES = ('light', 'dark')

SERVER_START_TIMEOUT_SEC = 60


def ensure_venv() -> None:
    """Re-run this script with the project's virtualenv, which has Playwright."""
    if Path(sys.prefix).resolve() == VENV.resolve():
        return
    if not VENV_PYTHON.exists():
        raise SystemExit('screenshots: no .venv -- run `uv sync --group dev` first')
    os.execv(VENV_PYTHON, [str(VENV_PYTHON), __file__, *sys.argv[1:]])


def run(argv: list[str], env: dict[str, str] | None = None) -> None:
    print(f'$ {" ".join(argv)}', flush=True)
    if subprocess.run(argv, cwd=ROOT, env=env).returncode != 0:
        raise SystemExit(f'screenshots: `{" ".join(argv)}` failed')


def instance_env(workdir: Path) -> dict[str, str]:
    """The environment of a fresh instance kept entirely inside `workdir`."""
    env = dict(os.environ)
    env.update(
        {
            # For `pysassc`, which compiles the theme when the page asks for it.
            'PATH': f'{VENV / "bin"}{os.pathsep}{env.get("PATH", "")}',
            'GLIFESTREAM_LOAD_DOTENV': '0',
            'GLIFESTREAM_ENABLE_SETTINGS_LOCAL': '0',
            'DJANGO_SETTINGS_MODULE': 'glifestream.settings',
            'APP_DEBUG': '1',
            'APP_SECRET_KEY': secrets.token_urlsafe(48),
            'ALLOWED_HOSTS': '127.0.0.1,localhost',
            'DATABASE_ENGINE': 'django.db.backends.sqlite3',
            'DATABASE_NAME': str(workdir / 'db.sqlite3'),
            'RUN_DIR': str(workdir / 'run'),
            'RUN_DIR_MEDIA': str(workdir / 'media'),
            'LANGUAGE_CODE': 'en-us',
            # Instead of the 'YOUR NAME' placeholder under the entry.
            'FEED_AUTHOR_NAME': 'gLifestream',
            'MAGICSSO_ENABLED': '0',
        }
    )
    return env


def free_port() -> int:
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', 0))
        return int(sock.getsockname()[1])


def wait_for_server(url: str, server: subprocess.Popen[bytes]) -> None:
    deadline = time.monotonic() + SERVER_START_TIMEOUT_SEC
    while time.monotonic() < deadline:
        if server.poll() is not None:
            raise SystemExit('screenshots: the server exited before it answered')
        try:
            with urllib.request.urlopen(url, timeout=5):
                return
        except (urllib.error.URLError, ConnectionError):
            time.sleep(0.25)
    raise SystemExit(f'screenshots: no answer from {url} in time')


def photograph(url: str, output_dir: Path) -> list[Path]:
    from PIL import Image
    from playwright.sync_api import sync_playwright

    written = []
    with sync_playwright() as playwright:
        browser = playwright.chromium.launch()
        try:
            for scheme in SCHEMES:
                context = browser.new_context(
                    viewport=VIEWPORT,  # type: ignore[arg-type]
                    device_scale_factor=SCALE,
                    color_scheme=scheme,  # type: ignore[arg-type]
                    locale='en-US',
                    timezone_id='UTC',
                    reduced_motion='reduce',
                )
                page = context.new_page()
                page.goto(url, wait_until='networkidle')
                page.evaluate('document.fonts.ready')
                # With DEBUG on, django-pipeline puts a failed compile on the
                # page instead of the stylesheet.
                if page.locator('.django-pipeline-error').count():
                    raise SystemExit(
                        'screenshots: the page shows a static-file error:\n'
                        + page.locator('.django-pipeline-error').first.inner_text()
                    )
                missing = page.evaluate(
                    """
                    [...document.images]
                        .filter((img) => !img.complete || img.naturalWidth === 0)
                        .map((img) => img.currentSrc || img.src)
                    """
                )
                if missing:
                    raise SystemExit(
                        'screenshots: images did not load: ' + ', '.join(missing)
                    )
                png = page.screenshot(
                    full_page=True, animations='disabled', caret='hide'
                )
                context.close()

                target = output_dir / f'stream-{scheme}.webp'
                with Image.open(BytesIO(png)) as image:
                    image.save(target, 'WEBP', quality=WEBP_QUALITY, method=6)
                written.append(target)
        finally:
            browser.close()
    return written


def main() -> int:
    parser = argparse.ArgumentParser(
        description='Take the light and dark README screenshots of the stream.'
    )
    parser.add_argument(
        '--output-dir',
        type=Path,
        default=OUTPUT_DIR,
        help=f'where to write the images (default: {OUTPUT_DIR.relative_to(ROOT)})',
    )
    args = parser.parse_args()
    ensure_venv()

    run(['npm', 'run', '--silent', 'build'])

    output_dir: Path = args.output_dir.resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory(prefix='gls-screenshots-') as tmp:
        workdir = Path(tmp)
        for name in ('templates', 'static'):
            (workdir / 'run' / name).mkdir(parents=True)
        env = instance_env(workdir)
        python = str(VENV_PYTHON)
        run([python, 'manage.py', 'migrate', '--run-syncdb', '-v', '0'], env)
        run([python, 'manage.py', 'load_initial_data'], env)
        run([python, 'manage.py', 'worker_init_files', '-v', '0'], env)

        port = free_port()
        url = f'http://127.0.0.1:{port}/'
        log_path = workdir / 'server.log'
        with log_path.open('wb') as log:
            server = subprocess.Popen(
                [python, 'manage.py', 'runserver', '--noreload', f'127.0.0.1:{port}'],
                cwd=ROOT,
                env=env,
                stdout=log,
                stderr=subprocess.STDOUT,
            )
            try:
                wait_for_server(url, server)
                written = photograph(url, output_dir)
            except BaseException:
                log.flush()
                sys.stderr.write(log_path.read_text(errors='replace'))
                raise
            finally:
                server.terminate()
                server.wait(timeout=10)

    for path in written:
        size_kib = path.stat().st_size / 1024
        print(f'wrote {path.relative_to(ROOT)} ({size_kib:.0f} KiB)')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
